#!/usr/bin/env bash
# coffeinate - a cozy wrapper around macOS caffeinate with ASCII coffee art
set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RESET='\033[0m'
BOLD='\033[1m'
DIM='\033[2m'
WHITE='\033[97m'
RED='\033[38;5;167m'
GOLD='\033[38;5;220m'
COFFEE='\033[38;5;130m'
LATTE='\033[38;5;216m'
CREAM='\033[38;5;223m'

# ── State ───────────────────────────────────────────────────────────────────
BG_PID=""
RECEIVED_SIGNAL=""
SILENT=false
HAS_ASSERTION=false
LID=false
LID_APPLIED=false
SUDO_PID=""

# ── Lid mode ────────────────────────────────────────────────────────────────
# Closing the lid raises a clamshell event that overrides every userspace power
# assertion, so nothing caffeinate does can survive it. The only lever is the
# kernel's SleepDisabled flag, which needs root to set and must be put back on
# the way out - leaving it on means the Mac never sleeps on lid close again.

lid_sleep_is_disabled() {
    ioreg -r -k SleepDisabled -d 1 2>/dev/null | grep -q '"SleepDisabled" = Yes'
}

set_lid_sleep() {  # $1: 1 to disable lid sleep, 0 to restore it
    sudo -n /usr/bin/pmset -a disablesleep "$1" 2>/dev/null \
        || sudo /usr/bin/pmset -a disablesleep "$1"
}

# Keep the sudo timestamp warm so the restore on exit never stops to ask for a
# password. Dies with the parent so a killed coffeinate leaves nothing behind,
# and takes its own sleep down with it rather than orphaning one.
start_sudo_keepalive() {
    local parent=$$
    (
        sleep_pid=""
        trap 'kill "$sleep_pid" 2>/dev/null; exit 0' TERM
        while kill -0 "$parent" 2>/dev/null; do
            sudo -n -v 2>/dev/null || true
            sleep 60 & sleep_pid=$!
            wait "$sleep_pid" 2>/dev/null || true
        done
    ) &
    SUDO_PID=$!
}

enable_lid_mode() {
    if lid_sleep_is_disabled; then
        echo "Note: lid sleep was already disabled before coffeinate started."
        echo "      Leaving it as it is on exit. To restore it yourself:"
        echo "          sudo pmset -a disablesleep 0"
        return 0
    fi
    if ! sudo -n true 2>/dev/null; then
        if [[ ! -t 0 ]]; then
            echo "Error: -L needs root and there is no terminal to ask on." >&2
            echo "       Allow pmset in sudoers, or run without -L." >&2
            exit 1
        fi
        echo "-L needs root to hold the lid open."
    fi
    set_lid_sleep 1 || { echo "Error: could not disable lid sleep." >&2; exit 1; }
    LID_APPLIED=true
    start_sudo_keepalive
}

restore_lid_mode() {
    [[ $LID_APPLIED == true ]] || return 0
    LID_APPLIED=false
    if ! set_lid_sleep 0; then
        echo "" >&2
        echo "Warning: lid sleep is still disabled. Restore it with:" >&2
        echo "    sudo pmset -a disablesleep 0" >&2
    fi
}

cleanup() {
    local exit_status=$?
    trap - EXIT INT TERM HUP QUIT  # prevent re-entry on cascading signals
    if [[ $SILENT == false ]]; then
        tput cnorm 2>/dev/null || true  # restore cursor
        printf '\033[?25h'              # belt-and-suspenders cursor restore
    fi
    if [[ -n "$BG_PID" ]]; then
        kill "$BG_PID" 2>/dev/null || true
        wait "$BG_PID" 2>/dev/null || exit_status=$?
    fi
    if [[ -n "$SUDO_PID" ]]; then
        kill "$SUDO_PID" 2>/dev/null || true
        wait "$SUDO_PID" 2>/dev/null || true
    fi
    restore_lid_mode
    [[ $SILENT == false ]] && echo ""
    case "$RECEIVED_SIGNAL" in
        INT)  exit_status=130 ;;
        TERM) exit_status=143 ;;
        HUP)  exit_status=129 ;;
        QUIT) exit_status=131 ;;
    esac
    exit "$exit_status"
}
trap cleanup EXIT
trap 'RECEIVED_SIGNAL=INT;  cleanup' INT
trap 'RECEIVED_SIGNAL=TERM; cleanup' TERM
trap 'RECEIVED_SIGNAL=HUP;  cleanup' HUP
trap 'RECEIVED_SIGNAL=QUIT; cleanup' QUIT

usage() {
    cat <<'USAGE'
coffeinate - keep your Mac awake, with style

Usage:
    coffeinate [options] [command ...]

Options:
    -d          Prevent display sleep (default)
    -i          Prevent idle sleep
    -m          Prevent disk idle sleep
    -s          Prevent sleep (AC power only)
    -u          Declare user active
    -L          Keep running with the lid closed (implies -i, needs sudo)
    -t <mins>   Timeout in minutes
    -T <HH:MM>  Shut down at given time
    -w <pid>    Wait for process to exit
    -q          Silent mode (no animation, no output)
    -h          Show this help

All flags except -L are passed through to /usr/bin/caffeinate.
-L disables lid sleep via pmset and restores it when coffeinate exits.
Press Ctrl-C to stop.
USAGE
    exit 0
}

# ── Parse args ──────────────────────────────────────────────────────────────
CAFF_ARGS=()
COMMAND=()

while (( $# )); do
    case "$1" in
        -h|--help) usage ;;
        -t)
            [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 1; }
            [[ $2 =~ ^[0-9]+$ ]] || { echo "Error: $1 requires a numeric value" >&2; exit 1; }
            CAFF_ARGS+=("$1" "$(( $2 * 60 ))"); shift 2 ;;
        -T)
            [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 1; }
            [[ $2 =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || { echo "Error: $1 requires HH:MM format (e.g. 17:30)" >&2; exit 1; }
            target_h=$((10#${2%:*}))
            target_m=$((10#${2#*:}))
            now_h=$((10#$(date +%H)))
            now_m=$((10#$(date +%M)))
            now_s=$((10#$(date +%S)))
            delta=$(( target_h * 3600 + target_m * 60 - (now_h * 3600 + now_m * 60 + now_s) ))
            (( delta <= 0 )) && delta=$(( delta + 86400 ))
            CAFF_ARGS+=("-t" "$delta"); shift 2 ;;
        -w)
            [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 1; }
            [[ $2 =~ ^[0-9]+$ ]] || { echo "Error: $1 requires a numeric value" >&2; exit 1; }
            CAFF_ARGS+=("$1" "$2"); shift 2 ;;
        -q) SILENT=true; shift ;;
        -L)
            # The display is off with the lid shut, so -d is meaningless here;
            # what the user wants is for the system itself to stay up.
            [[ $LID == false ]] && CAFF_ARGS+=("-i")
            LID=true; HAS_ASSERTION=true; shift ;;
        -d|-i|-m|-s|-u) CAFF_ARGS+=("$1"); HAS_ASSERTION=true; shift ;;
        --) shift; COMMAND=("$@"); break ;;
        -*) CAFF_ARGS+=("$1"); shift ;;
         *) COMMAND=("$@"); break ;;
    esac
done

# Default to preventing display sleep unless the user picked another assertion
[[ $HAS_ASSERTION == false ]] && CAFF_ARGS+=("-d")

# Do this before the cursor is hidden so any sudo prompt lands on a clean screen
[[ $LID == true ]] && enable_lid_mode

# ── Steam animation frames ─────────────────────────────────────────────────
# 6 frames of steam rising above the mug, aligned to the 10-char mug width.

steam_frame_0=(
    '        '
    '  )    ('
    ' (  )  )'
    '  )  ( '
)
steam_frame_1=(
    ' (  )   '
    '  )  (  '
    ' (    ) '
    '  ) (   '
)
steam_frame_2=(
    '        '
    '  )  (  '
    ' (  )  )'
    '  )    ('
)
steam_frame_3=(
    ' )    ( '
    '  (  )  '
    ' )  (   '
    '  (  )  '
)
steam_frame_4=(
    '  (  )  '
    ' )    ( '
    '  (  )  '
    '        '
)
steam_frame_5=(
    ' )  (   '
    '  )  (  '
    '        '
    ' (  )  )'
)

# ── The mug ─────────────────────────────────────────────────────────────────
# Tall Latte style with colored regions drawn in draw_frame().

# ── Drawing ─────────────────────────────────────────────────────────────────
# steam(4) + mug(7) = 11, plus one status line in lid mode
TOTAL_HEIGHT=11
[[ $LID == true ]] && TOTAL_HEIGHT=12

draw_frame() {
    local frame_num=$(( $1 % 6 ))
    # Move cursor to top of our drawing area
    printf '\033[%dA' "$TOTAL_HEIGHT"

    # Steam
    local steam_ref="steam_frame_${frame_num}[@]"
    local steam_lines=("${!steam_ref}")
    for line in "${steam_lines[@]}"; do
        printf '\033[2K    '"${DIM}${WHITE}%s${RESET}"'\n' "$line"
    done

    # Mug: Tall Latte
    printf '\033[2K    '"${RED}┌────────┐${RESET}"'\n'
    printf '\033[2K    '"${RED}│${COFFEE}~~~~~~~~${RED}│${GOLD}─┐${RESET}"'\n'
    printf '\033[2K    '"${RED}│${LATTE}        ${RED}│${GOLD} │${RESET}"'\n'
    printf '\033[2K    '"${RED}│${CREAM}${BOLD} COFFEE ${RESET}${RED}│${GOLD} │${RESET}"'\n'
    printf '\033[2K    '"${RED}│${LATTE}        ${RED}│${GOLD}─┘${RESET}"'\n'
    printf '\033[2K    '"${RED}│${CREAM}${DIM}........${RESET}${RED}│${RESET}"'\n'
    printf '\033[2K    '"${RED}└────────┘${RESET}"'\n'

    # Status line (lid mode only) - keep in step with TOTAL_HEIGHT
    if [[ $LID == true ]]; then
        printf '\033[2K    '"${DIM}${WHITE}closing lid is ok${RESET}"'\n'
    fi
}

# ── Main ────────────────────────────────────────────────────────────────────
# Launch real caffeinate in the background
if (( ${#COMMAND[@]} )); then
    /usr/bin/caffeinate ${CAFF_ARGS[@]+"${CAFF_ARGS[@]}"} -- "${COMMAND[@]}" &
else
    /usr/bin/caffeinate ${CAFF_ARGS[@]+"${CAFF_ARGS[@]}"} &
fi
BG_PID=$!

if [[ $SILENT == true ]]; then
    wait "$BG_PID" 2>/dev/null || true
else
    # Hide cursor
    tput civis 2>/dev/null || true

    # Print initial blank lines to reserve space
    for (( i = 0; i < TOTAL_HEIGHT; i++ )); do
        echo ""
    done

    # Animate
    frame=0
    while true; do
        # Check if the background process exited (command finished or timeout)
        if ! kill -0 "$BG_PID" 2>/dev/null; then
            break
        fi

        draw_frame "$frame"
        (( ++frame ))
        sleep 0.3
    done
fi
